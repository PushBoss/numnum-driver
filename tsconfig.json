{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "moduleSuffixes": [".native", ".web", ""],
    "strict": true,
    "baseUrl": ".",
    "types": ["react", "react-native"],
    "paths": {
      "@/*": ["src/*"],
      "@num-num/shared": ["../../packages/shared/src"],
      "@num-num/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src", "App.tsx"],
  "exclude": ["dist", "node_modules", "src/__tests__"]
}
