{
  "expo": {
    "name": "NumNum Driver",
    "slug": "num-num-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/brand/favicon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#101614"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.numnum.driver"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#101614"
      },
      "package": "com.numnum.driver"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./src/assets/brand/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-location",
      "expo-web-browser"
    ]
  }
}
